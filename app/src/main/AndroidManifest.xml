<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

	<uses-permission android:name="android.permission.INTERNET" />

	<application
		android:allowBackup="false"
		android:icon="@drawable/ic_launcher"
		android:label="MiniSpot"
		android:theme="@style/AppTheme">

		<!-- Kyocera soft key bar labels (absent on other phones) -->
		<uses-library android:name="com.nextfp.android.util" android:required="false" />

		<!-- Free account: media session remote. Premium login: Web API browsing too. -->
		<activity
			android:name=".RemoteActivity"
			android:configChanges="keyboard|keyboardHidden|orientation|screenSize|navigation"
			android:exported="true"
			android:launchMode="singleTask"
			android:screenOrientation="portrait"
			android:windowSoftInputMode="stateHidden|adjustResize">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
			<!-- Spotify login comes back here from the browser -->
			<intent-filter>
				<action android:name="android.intent.action.VIEW" />
				<category android:name="android.intent.category.DEFAULT" />
				<category android:name="android.intent.category.BROWSABLE" />
				<data android:scheme="minispot" android:host="callback" />
			</intent-filter>
		</activity>

		<service
			android:name=".NotifListener"
			android:exported="true"
			android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
			<intent-filter>
				<action android:name="android.service.notification.NotificationListenerService" />
			</intent-filter>
		</service>

		<!-- Login made on the PC (login-pc.bat). DUMP: only adb can send it. -->
		<receiver
			android:name=".TokenReceiver"
			android:exported="true"
			android:permission="android.permission.DUMP" />
	</application>
</manifest>
